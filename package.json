{
  "name": "testnexus-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered intelligent regression testing platform",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --test",
    "inspect-pr": "node src/commands/inspect-pull-request.js",
    "analyze": "node src/commands/analyze.js",
    "evaluate": "node src/commands/evaluate.js",
    "dashboard:sync": "node src/commands/sync-dashboard.js",
    "playwright-grep": "node src/commands/playwright-grep.js",
    "suite": "node src/commands/run-suite.js",
    "suites:server": "node src/commands/suite-server.js",
    "dev:all": "node src/commands/dev-all.js",
    "test:e2e": "playwright test",
    "check": "find src tests -name \"*.js\" -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
